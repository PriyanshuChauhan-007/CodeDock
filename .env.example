# Application
APP_NAME=CodeDock API
APP_ENV=development
LOG_LEVEL=INFO

# Database
POSTGRES_DB=codedock
POSTGRES_USER=codedock
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://codedock:change-me-for-local-development@localhost:5432/codedock

# Queue and rate limiting
REDIS_URL=redis://localhost:6379/0

# Authentication placeholder for local development.
# Replace before implementing authentication.
JWT_SECRET_KEY=replace-with-a-development-secret
JWT_ACCESS_TOKEN_MINUTES=15
